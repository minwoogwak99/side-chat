{
  // Standalone typecheck (no emit). Harness packages resolve through
  // node_modules/@deepseek-ai symlinks created by scripts/link-harness.mjs
  // (run automatically by `pnpm run typecheck`); their built lib/types
  // declarations load under skipLibCheck.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
