{
  "name": "dsh-plugin-side-chat",
  "description": "Web side-chat plugin: select a passage of an assistant message, ask follow-up questions in a right-side panel backed by a fresh side session",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "link-harness": "node scripts/link-harness.mjs",
    "typecheck": "node scripts/link-harness.mjs && tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && tsdown",
    "test": "vitest run",
    "bundle": "tsdown"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "~18.3.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
